# StockPhotonic local review pipeline environment.
# Keep real values in your local shell, GitHub Secrets, or an untracked .env file.

# Optional OpenAlex API key for bounded scheduled/local enrichment.
# The browser never reads this value.
OPENALEX_API_KEY=

# Required only for SEC network fetches. Use an identifying contact string.
# Example: "Infused StockPhotonic infusednft@gmail.com"
SEC_USER_AGENT=
